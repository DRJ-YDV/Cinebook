# TMDB (The Movie Database) — https://www.themoviedb.org/settings/api
# Server-side only. Never expose these to the browser.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# Optional public movie metadata cache. An empty value disables disk caching.
TMDB_CACHE_FILE=.cache/tmdb-catalogue.json

# MongoDB Atlas — CineBook application data (users, theatres, screens, shows,
# seats, bookings, payments, favorites, offers).
# Official MongoDB Node.js driver. Server-side only: never commit the real URI
# and never expose it to the browser. Requires a Node.js server runtime.
MONGODB_URI=
MONGODB_DB=cinebook

# Cookie encryption key for server-verified sign-in sessions (at least 32 chars).
SESSION_SECRET=

# Register this account normally, then run `node promote-admins.cjs` (dry-run).
# After review, `node promote-admins.cjs --apply` grants only that existing account admin.
# Registration always creates a normal user. Legacy ADMIN_EMAILS no longer grants roles.
CINEBOOK_ADMIN_EMAIL=

# Token required by the /admin "Seed database" button.
CINEBOOK_SEED_TOKEN=

# Razorpay Standard Checkout — TEST MODE keys only (rzp_test_...).
# The Key ID is sent to the browser by the server; the Key Secret is
# server-side only and must never be committed or exposed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
